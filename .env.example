# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STREAMWALL_API_ORIGIN: Default upstream catalogue & player origin (editable live in Admin).
STREAMWALL_API_ORIGIN="https://streamwall.behoririka.mg"

# SUPABASE (Optional — connect your online Supabase project over HTTPS)
# Configure these in the AI Studio Secrets panel to use your live Supabase database & Auth.
SUPABASE_URL="https://vfwzxgrnzvdsoqfpdzfd.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_OPTIONAL_SUPABASE_SERVICE_ROLE_KEY"

# CRYPTOGATE PAYMENTS (Optional — configure in AI Studio Secrets for https://crypto-gate.cc/)
CRYPTO_GATE_API_KEY="YOUR_CRYPTOGATE_API_KEY"
CRYPTO_GATE_WEBHOOK_SECRET="YOUR_CRYPTOGATE_WEBHOOK_SECRET"
